{
  "params": [
    {
      "name": "pa_legend",
      "select": {
        "type": "point",
        "fields": [
          "region"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "quarter",
      "type": "nominal",
      "title": "Quarter",
      "sort": null,
      "axis": {
        "labelOverlap": false,
        "labelAngle": {
          "expr": "bandwidth('x') < 20 ? -45 : 0"
        },
        "labelAlign": {
          "expr": "bandwidth('x') < 20 ? 'right' : 'center'"
        }
      }
    },
    "y": {
      "field": "revenue",
      "type": "quantitative",
      "title": "Revenue",
      "stack": "normalize",
      "axis": {
        "format": ".0%"
      }
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "title": "Region"
    },
    "tooltip": [
      {
        "field": "quarter",
        "type": "nominal",
        "title": "Quarter"
      },
      {
        "field": "revenue",
        "type": "quantitative",
        "title": "Revenue"
      },
      {
        "field": "region",
        "type": "nominal",
        "title": "Region"
      }
    ],
    "opacity": {
      "condition": {
        "param": "pa_legend",
        "empty": true,
        "value": 1
      },
      "value": 0.2
    }
  }
}
