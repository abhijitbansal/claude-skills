{
  "params": [
    {
      "name": "pa_hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "region",
      "type": "nominal",
      "title": "Region",
      "sort": "-y",
      "axis": {
        "labelOverlap": false,
        "labelAngle": {
          "expr": "bandwidth('x') < 41 ? -45 : 0"
        },
        "labelAlign": {
          "expr": "bandwidth('x') < 41 ? 'right' : 'center'"
        }
      }
    },
    "y": {
      "field": "revenue",
      "type": "quantitative",
      "title": "Revenue"
    },
    "tooltip": [
      {
        "field": "region",
        "type": "nominal",
        "title": "Region"
      },
      {
        "field": "revenue",
        "type": "quantitative",
        "title": "Revenue"
      }
    ],
    "opacity": {
      "condition": {
        "param": "pa_hover",
        "empty": true,
        "value": 1
      },
      "value": 0.55
    }
  }
}
