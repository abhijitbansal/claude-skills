{
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month",
      "timeUnit": "utcyearmonth",
      "scale": {
        "type": "utc"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pa_zoom",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          },
          "bind": "scales"
        }
      ],
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "title": "Revenue"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "legend": null
        }
      }
    },
    {
      "params": [
        {
          "name": "pa_x",
          "select": {
            "type": "point",
            "encodings": [
              "x"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "tooltip": false
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "pa_x",
            "empty": false,
            "value": 0.5
          },
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "title": "Revenue"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "legend": null
        },
        "tooltip": [
          {
            "field": "month",
            "type": "temporal",
            "title": "Month",
            "timeUnit": "utcyearmonth"
          },
          {
            "field": "revenue",
            "type": "quantitative",
            "title": "Revenue"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          }
        ],
        "opacity": {
          "condition": {
            "param": "pa_x",
            "empty": false,
            "value": 1
          },
          "value": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "revenue",
            "valid": true
          }
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "paEndRank"
            }
          ],
          "sort": [
            {
              "field": "month",
              "order": "descending"
            }
          ],
          "groupby": [
            "region"
          ]
        },
        {
          "filter": "datum.paEndRank === 1"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 36,
        "opacity": 1,
        "tooltip": false,
        "clip": false
      },
      "encoding": {
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "title": "Revenue"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "revenue",
            "valid": true
          }
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "paEndRank"
            }
          ],
          "sort": [
            {
              "field": "month",
              "order": "descending"
            }
          ],
          "groupby": [
            "region"
          ]
        },
        {
          "filter": "datum.paEndRank === 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "tooltip": false,
        "clip": false
      },
      "encoding": {
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "title": "Revenue"
        },
        "text": {
          "field": "region",
          "type": "nominal"
        }
      }
    }
  ],
  "padding": {
    "top": 5,
    "bottom": 5,
    "left": 5,
    "right": 42
  }
}
