{
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "pa_total"
        }
      ]
    },
    {
      "calculate": "datum[\"revenue\"] / datum.pa_total",
      "as": "pa_share"
    }
  ],
  "encoding": {
    "x": {
      "field": "region",
      "type": "nominal",
      "title": "Region",
      "sort": null,
      "axis": {
        "labelOverlap": false,
        "labelAngle": {
          "expr": "bandwidth('x') < 41 ? -45 : 0"
        },
        "labelAlign": {
          "expr": "bandwidth('x') < 41 ? 'right' : 'center'"
        }
      }
    },
    "y": {
      "field": "pa_share",
      "type": "quantitative",
      "title": "Share of revenue",
      "axis": {
        "format": ".0%"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pa_hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": "bar",
      "encoding": {
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "revenue",
            "type": "quantitative",
            "title": "Revenue"
          },
          {
            "field": "pa_share",
            "type": "quantitative",
            "title": "Share of revenue",
            "format": ".1%"
          }
        ],
        "opacity": {
          "condition": {
            "param": "pa_hover",
            "empty": true,
            "value": 1
          },
          "value": 0.55
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "tooltip": false,
        "align": "center",
        "baseline": "bottom",
        "dy": -4,
        "opacity": {
          "expr": "bandwidth('x') >= 34 ? 1 : 0"
        }
      },
      "encoding": {
        "text": {
          "field": "pa_share",
          "type": "quantitative",
          "format": ".0%"
        }
      }
    }
  ],
  "padding": {
    "top": 19,
    "bottom": 5,
    "left": 5,
    "right": 5
  }
}
