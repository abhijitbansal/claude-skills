{
  "params": [
    {
      "name": "pa_hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "region",
      "type": "nominal",
      "title": "region",
      "sort": null
    },
    "y": {
      "field": "pa_share",
      "type": "quantitative",
      "title": "Share of revenue",
      "axis": {
        "format": ".0%"
      }
    },
    "opacity": {
      "condition": {
        "param": "pa_hover",
        "empty": true,
        "value": 1
      },
      "value": 0.55
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "pa_total"
        }
      ]
    },
    {
      "calculate": "datum[\"revenue\"] / datum.pa_total",
      "as": "pa_share"
    }
  ]
}
