{
  "params": [
    {
      "name": "pa_zoom",
      "select": {
        "type": "interval"
      },
      "bind": "scales"
    },
    {
      "name": "pa_legend",
      "select": {
        "type": "point",
        "fields": [
          "g"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "point",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "a",
      "type": "quantitative",
      "title": "a"
    },
    "y": {
      "field": "b",
      "type": "quantitative",
      "title": "b"
    },
    "color": {
      "field": "g",
      "type": "nominal",
      "title": "g"
    },
    "opacity": {
      "condition": {
        "param": "pa_legend",
        "empty": true,
        "value": 1
      },
      "value": 0.2
    }
  }
}
