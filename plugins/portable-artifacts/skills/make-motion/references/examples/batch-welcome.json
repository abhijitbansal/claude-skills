{
  "size": [1920, 1080],
  "fps": 30,
  "vars": {
    "name": { "type": "string", "default": "Ada Lovelace" },
    "team": { "type": "string", "default": "Platform" },
    "day": { "type": "number", "default": 1 }
  },
  "scenes": [
    {
      "id": "welcome",
      "duration": 3.5,
      "background": "art",
      "elements": [
        {
          "id": "kicker",
          "type": "text",
          "text": "Welcome aboard",
          "x": 960,
          "y": 330,
          "fontSize": 40,
          "fontWeight": 400
        },
        {
          "id": "name",
          "type": "text",
          "role": "title",
          "text": "{{name}}",
          "x": 960,
          "y": 480,
          "fontSize": 132,
          "fontWeight": 700,
          "maxWidth": 1600
        },
        {
          "id": "team",
          "type": "text",
          "text": "Team {{team}} · you start on day {{day}}",
          "x": 960,
          "y": 660,
          "fontSize": 52,
          "fontWeight": 500,
          "keyframes": [
            { "t": 0.8, "opacity": 0, "y": 690 },
            { "t": 1.3, "opacity": 1, "y": 660, "ease": "enter" }
          ]
        }
      ]
    }
  ]
}
