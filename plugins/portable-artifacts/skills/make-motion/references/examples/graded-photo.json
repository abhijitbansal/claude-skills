        { "id": "label-cool", "type": "text", "text": "cool", "x": 732, "y": 720, "fontSize": 44, "fontWeight": 600, "hold": true },
        { "id": "label-mono", "type": "text", "text": "mono", "x": 1188, "y": 720, "fontSize": 44, "fontWeight": 600, "hold": true },
