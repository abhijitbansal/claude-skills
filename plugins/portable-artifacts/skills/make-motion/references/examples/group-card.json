{
  "size": [1920, 1080],
  "fps": 30,
  "scenes": [
    {
      "id": "stats",
      "duration": 5,
      "elements": [
        {
          "id": "headline",
          "type": "text",
          "text": "One card, moved as one",
          "x": 960,
          "y": 170,
          "fontSize": 64,
          "fontWeight": 700
        },
        {
          "id": "card",
          "type": "group",
          "x": 960,
          "y": 600,
          "keyframes": [
            { "t": 0, "y": 700 },
            { "t": 0.9, "y": 600, "ease": "enter" },
            { "t": 2.6, "scale": 1 },
            { "t": 3.2, "scale": 1.06, "ease": "move" }
          ],
          "children": [
            { "id": "panel", "type": "shape", "shape": "rect", "x": 0, "y": 0, "width": 760, "height": 360, "radius": 28, "fill": "surface", "elevated": true },
            { "id": "label", "type": "text", "text": "Monthly active users", "x": 0, "y": -110, "fontSize": 32, "fontWeight": 500, "color": "text2" },
            { "id": "users", "type": "counter", "from": 0, "to": 48200, "x": 0, "y": -10, "fontSize": 96, "fontWeight": 700 },
            {
              "id": "rule",
              "type": "shape",
              "shape": "line",
              "x": 0,
              "y": 70,
              "width": 600,
              "strokeWidth": 4,
              "stroke": "accent",
              "keyframes": [{ "t": 0.6, "draw": 0 }, { "t": 1.4, "draw": 1, "ease": "outCubic" }]
            },
            { "id": "change", "type": "text", "text": "+12% on last month", "x": 0, "y": 125, "fontSize": 32, "fontWeight": 600, "color": "good" }
          ]
        }
      ]
    }
  ]
}
