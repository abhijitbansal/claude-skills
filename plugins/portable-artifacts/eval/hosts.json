{
  "claude": {
    "cmd": ["claude", "-p", "{prompt}", "--permission-mode", "acceptEdits",
            "--allowedTools", "Read", "Write", "Edit", "Glob", "Grep", "Bash(node:*)", "Bash(npm:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(echo:*)", "Bash(pwd:*)", "Bash(head:*)"],
    "modelArgs": ["--model", "{model}"],
    "check": ["claude", "--version"]
  },
  "claude-frontmatter": {
    "cmd": ["claude", "-p", "{prompt}", "--permission-mode", "acceptEdits",
            "--allowedTools", "Read", "Write", "Edit", "Glob", "Grep", "Bash(node:*)", "Bash(npm:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(echo:*)", "Bash(pwd:*)", "Bash(head:*)"],
    "check": ["claude", "--version"]
  },
  "claude-director": {
    "cmd": ["claude", "-p", "{prompt}", "--permission-mode", "acceptEdits",
            "--output-format", "stream-json", "--verbose", "--forward-subagent-text", "--include-hook-events",
            "--setting-sources", "project",
            "--allowedTools", "Read", "Write", "Edit", "Glob", "Grep", "Agent", "Task", "Bash(node:*)", "Bash(npm:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(echo:*)", "Bash(pwd:*)", "Bash(head:*)"],
    "budgetArgs": ["--max-budget-usd", "{budget}"],
    "agentFile": "claude",
    "check": ["claude", "--version"]
  },
  "codex": {
    "cmd": ["codex", "exec", "-s", "workspace-write", "--skip-git-repo-check", "-C", "{cwd}", "{prompt}"],
    "modelArgs": ["-m", "{model}"],
    "check": ["codex", "--version"]
  },
  "codex-oss": {
    "cmd": ["codex", "exec", "--oss", "--local-provider", "ollama", "-s", "workspace-write", "--skip-git-repo-check", "-C", "{cwd}", "{prompt}"],
    "modelArgs": ["-m", "{model}"],
    "local": true,
    "abortNoSpecSec": 240,
    "check": ["ollama", "--version"]
  },
  "gemini": {
    "cmd": ["gemini", "-p", "{prompt}", "--yolo"],
    "modelArgs": ["-m", "{model}"],
    "check": ["gemini", "--version"]
  },
  "copilot": {
    "cmd": ["copilot", "-p", "{prompt}", "--allow-all-tools"],
    "modelArgs": ["--model", "{model}"],
    "agentArgs": ["--agent", "{agent}"],
    "check": ["copilot", "--version"]
  }
}
