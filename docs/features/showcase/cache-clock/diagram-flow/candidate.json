  "cards": [
    {
      "dot": "rose",
      "title": "Refusal contract",
      "items": [
        "session.abort() is not awaited: awaiting it inside the hook deadlocks.",
        "Refused episodes live in refused.json for 7 days, so a resend from a new process goes through.",
        "A queued prompt during a running turn is never refused, only priced."
      ]
    },
    {
      "dot": "amber",
      "title": "Limits",
      "items": [
        "Early eviction: Luna was served cold at 29 of 30 min. The guard trusts cacheExpiresAt and stays quiet; the report counts a prefix break.",
        "The price is an estimate: last input plus answer, not your new message.",
        "With auto, the next prompt may use a different model than the one priced.",
        "copilot -p: the guard works, but slash commands go to the model as text."
      ]
    }
  ]
